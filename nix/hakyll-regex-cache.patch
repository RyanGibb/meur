+-- | Compiled regexes, cached. 'Pattern' stores regexes as strings and
+-- 'matches' runs many times per pattern, so compiling on every call can
+-- dominate build time on regex-heavy sites.
+{-# NOINLINE regexCacheRef #-}
+regexCacheRef :: IORef (M.Map String Regex)
+regexCacheRef = unsafePerformIO (newIORef M.empty)
+
+
+--------------------------------------------------------------------------------
+compiledRegex :: String -> Regex
+compiledRegex r = unsafePerformIO $ do
+    cache <- readIORef regexCacheRef
+    case M.lookup r cache of
+        Just c  -> return c
+        Nothing -> do
+            let c = makeRegex r
+            atomicModifyIORef' regexCacheRef (\m -> (M.insert r c m, ()))
+            return c
+
+
+--------------------------------------------------------------------------------
 -- | Check if an identifier matches a pattern
 matches :: Pattern -> Identifier -> Bool
 matches Everything     _ = True
